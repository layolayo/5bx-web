# Public HTTPS block for primary instance (port 5000)
layolayo.synology.me {
    # Block automated vulnerability scanners and nuisance requests
    @blocked_scanners {
        path /.git/* /.git
        path /.env /.env.*
        path /wp-admin/* /wp-login.php /wp-config.php
        path /xmlrpc.php
        path /.svn/* /.svn
        path /.DS_Store
        path /admin/* /administrator/*
        path /backup/* /backups/*
        path /phpinfo.php /info.php
        path /service-account.json /sa.json /gcp-key.json /credentials.json /google-credentials.json
    }
    
    # Respond with 404 (pretend the path doesn't exist) and close the TCP connection
    respond @blocked_scanners "Not Found" 404 {
        close
    }

    reverse_proxy localhost:5000
    encode gzip zstd
}

