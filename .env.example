# -----------------------------------------------------------------------------
# 5BX Web Application Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
# NEVER commit your actual .env file or sensitive passwords to version control.
# -----------------------------------------------------------------------------

# Primary Database Connection String (PostgreSQL)
DATABASE_URL=postgres://fivebx_app:REPLACE_WITH_SECURE_PASSWORD@127.0.0.1:5432/fivebx?sslmode=disable

# Cryptographic JWT Secret (minimum 32 characters)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_STRING_AT_LEAST_32_BYTES_LONG

# Server Binding
HOST=0.0.0.0
PORT=8085

# Environment (development | production)
APP_ENV=production

# Logging Level (info | debug | warn | error)
RUST_LOG=info
